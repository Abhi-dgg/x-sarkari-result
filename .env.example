# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Model AI Keys: Support for ChatGPT (OpenAI), Claude (Anthropic), and Grok (xAI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROK_API_KEY=""
XAI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Database connection URL (PostgreSQL / Neon compatible)
DATABASE_URL="postgresql://user:password@localhost:5432/xsarkarijob?schema=public"

# Auth and Session Secret
AUTH_SECRET="your-random-32-byte-hex-or-base64-secret"

# Public site URL
NEXT_PUBLIC_SITE_URL="https://xsarkarijob.com"

# Contact and Legal settings
CONTACT_EMAIL="support@xsarkarijob.com"
LEGAL_NAME="X Sarkari Job Media & Information Network"

# Optional Email / Notification SMTP settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFICATION_FROM_EMAIL="alerts@xsarkarijob.com"

# Analytics and Cron automation
GOOGLE_ANALYTICS_ID=""
CRON_SECRET="your-cron-secret-key"
ADMIN_INITIAL_EMAIL="admin@xsarkarijob.com"
